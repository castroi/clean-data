# SECURITY: Never commit .env to version control. Set file permissions: chmod 600 .env

# Signal bot configuration — this bot's own number, registered on the shared
# signal-cli. Its wrapper pins every send/receive to it.
SIGNAL_PHONE_NUMBER=+972XXXXXXXXX

# The shared signal-cli's URL on signal-net (used by wrapper-clean-data).
# Its service alias varies by host (find it: docker inspect <signal-cli container>).
SIGNAL_BACKEND_URL=http://signal-api:8080

# The bearer token is NOT set here. It lives only in the Docker secret
# ./secrets/signal_token, read by both clean-data and its wrapper:
#   mkdir -p secrets && openssl rand -hex 32 > secrets/signal_token && chmod 600 secrets/signal_token

# Set automatically by docker-compose, but can be overridden for local runs:
# SIGNAL_API_URL=http://wrapper-clean-data:8080
# SIGNAL_TOKEN_FILE=/run/secrets/signal_token
# SIGNAL_TOKEN=            # local/testing fallback when no token file
# TEMP_DIR=/tmp/clean-data

MAX_FILE_SIZE_MB=25
PROCESSING_TIMEOUT=300

# SECURITY: Uncomment and set ALLOWED_SENDERS to restrict who can use this service.
# Leaving this unset means ANY Signal user can send documents for processing.
# ALLOWED_SENDERS=+972501234567,+972509876543

# TTL for /replace word sessions in seconds (default: 3600 = 1 hour)
# WORD_SESSION_TTL_SECONDS=3600
