# ---------------------------------------------------------------------------
# clean-data — environment configuration
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this `.env.example` (no secrets) is committed as the template.
#
#   cp .env.example .env && chmod 600 .env
#
# Never commit real secrets. The Signal token is NOT set here (see below).
#
# Under Docker, only the variables listed in docker-compose.yml reach the bot
# (.env is used for ${...} substitution, not passed wholesale). `docker compose
# up` refuses to start when a REQUIRED value is missing, and the bot itself
# refuses to start on a missing token file or an invalid ALLOWED_SENDERS.
# ---------------------------------------------------------------------------

# === REQUIRED ===============================================================

# This bot's own dedicated Signal number (E.164), registered on the shared
# signal-cli. Its wrapper (wrapper-clean-data) pins every send and receive to
# it, so the bot can never send as another number.
SIGNAL_PHONE_NUMBER=+10000000000

# The shared signal-cli's URL on signal-net, used by wrapper-clean-data's
# BACKEND_URL. Its service alias varies by host
# (find it: docker inspect <signal-cli container>). No query string.
SIGNAL_BACKEND_URL=http://signal-api:8080

# Bearer token (for /v2/send, the receive WebSocket and attachment
# download/delete) is NOT set here. It lives only in the Docker secret
# ./secrets/signal_token, read by both clean-data and its wrapper via
# SIGNAL_TOKEN_FILE. Create it once:
#   mkdir -p secrets && openssl rand -hex 32 > secrets/signal_token
#   sudo chgrp 10001 secrets/signal_token && chmod 640 secrets/signal_token
# (group 10001 is added to both containers in docker-compose.yml: the wrapper
#  runs as uid 65532 and clean-data as uid 1000, so mode 600 would lock one out)

# Authorized senders — comma-separated Signal sourceUuids (ACI), NOT phone
# numbers (identity is pinned on the UUID; the number may be hidden). At least
# one is required: the bot is never open to everyone. Any entry that is not a
# valid UUID also stops startup (fail closed, nothing skipped).
# Senders not in the list are dropped silently: no reply, their id and message
# are not logged (only a rate-limited count), and any files they sent are still
# deleted from signal-cli. Messages without a sourceUuid are dropped too.
#
# To find someone's UUID: have them message the bot once, then list the bot's
# contacts on the shared signal-cli directly (not through the wrapper, which
# blocks it), e.g. GET <signal-cli>/v1/contacts/<SIGNAL_PHONE_NUMBER>, and take
# their "uuid".
ALLOWED_SENDERS=11111111-2222-3333-4444-555555555555

# === OPTIONAL ===============================================================

# Largest accepted input document in MB (checked on the real downloaded size,
# not Signal's metadata). The cleaned file must also fit the wrapper's send
# cap (SIGNAL_MAX_SEND_BYTES, ~28 MB of file); raise both together.
# MAX_FILE_SIZE_MB=25

# Maximum time to clean one document, in seconds. The original is deleted from
# signal-cli before processing starts, and temp files are deleted on timeout.
# PROCESSING_TIMEOUT=300

# Custom-word lists (words a user sends as text; per sender, in memory only):
# WORD_SESSION_TTL_SECONDS=7200   # cleared after 2 hours with no message or file
# MAX_WORDS_PER_SENDER=30
# MAX_WORD_LENGTH=100
# MAX_WORD_SESSIONS=100           # concurrent senders with an active session
# MAX_WORD_SESSION_AGE_SECONDS=86400  # hard cap: cleared 24 h after the list started, even if active

# === FIXED IN docker-compose.yml (only used for local runs: python3 main.py) =
# Under Docker these values come from docker-compose.yml; setting them here has
# no effect there.

# This bot's wrapper — never signal-cli directly.
# SIGNAL_API_URL=http://wrapper-clean-data:8080
# SIGNAL_TOKEN_FILE=/run/secrets/signal_token
# SIGNAL_TOKEN=                     # local/testing fallback when no token file

# Temp files (originals and cleaned copies); keep on tmpfs so PII never hits disk.
# TEMP_DIR=/tmp/clean-data

# Must equal the wrapper's MAX_BODY_BYTES: a cleaned file whose base64 would be
# bigger is not sent, and the user is told.
# SIGNAL_MAX_SEND_BYTES=40000000

# Touched on every frame/pong from the receive stream; the Docker healthcheck
# fails when it is older than 120 s. Empty disables it.
# HEARTBEAT_FILE=/tmp/heartbeat
